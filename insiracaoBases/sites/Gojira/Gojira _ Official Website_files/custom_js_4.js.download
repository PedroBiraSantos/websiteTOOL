jQuery(window).bind("load", function(){
	$("#block-views-block-music-v1-block-1 .dvd-desc").mCustomScrollbar({
        mouseWheel: true,
        scrollInertia: 0,
        scrollButtons: {
            enable: true
        }
    });
	$(".view-categories .view-content ul").my_magicline();
    $(".path-music #block-acq-starterm-copy-2-system-main .view-header .album-category-header").mymusic_magicline();
});
 
